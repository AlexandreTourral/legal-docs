---
import { url } from '../lib/content';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
}

const { title, description, crumbs = [] } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header>
      <nav aria-label="Fil d'Ariane">
        <a href={url()}>Documents légaux</a>
        {
          crumbs.map((c) => (
            <>
              <span aria-hidden="true">›</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --surface: #ffffff;
    --text: #1c1917;
    --muted: #78716c;
    --border: #e7e5e4;
    --accent: #2563eb;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0a09;
      --surface: #1c1917;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --border: #292524;
      --accent: #60a5fa;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.65 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  header,
  main {
    max-width: 72ch;
    margin: 0 auto;
    padding: 0 16px;
  }
  header {
    padding-top: 24px;
  }
  header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
  }
  main {
    padding-bottom: 64px;
  }
  a {
    color: var(--accent);
  }
  header a {
    color: var(--muted);
    text-decoration: none;
  }
  header a:hover {
    color: var(--text);
  }
  h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 24px 0 8px;
  }
  .muted {
    color: var(--muted);
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 12px;
  }
  .cards a {
    display: block;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .cards a:hover {
    border-color: var(--accent);
  }
  .cards strong {
    display: block;
    font-size: 1.05rem;
  }
  .cards span {
    color: var(--muted);
    font-size: 14px;
  }
</style>
