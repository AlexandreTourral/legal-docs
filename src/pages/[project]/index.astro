---
import Layout from '../../layouts/Layout.astro';
import { docSlug, formatDate, getDocs, getProjects, url, getMeta, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { project: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const docs = await getDocs(project.id);
---

<Layout title={`${project.name} — Documents légaux`} crumbs={[{ label: project.name }]}>
  <h1>{project.name}</h1>
  {project.description && <p class="muted">{project.description}</p>}
  <ul class="cards">
    {
      docs.map((d) => (
        <li>
          <a href={url(`${project.id}/${docSlug(d)}`)}>
            <strong>{getMeta(d).title}</strong>
            <span>{getMeta(d).updatedAt && `Mis à jour le ${formatDate(getMeta(d).updatedAt!)}`}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
